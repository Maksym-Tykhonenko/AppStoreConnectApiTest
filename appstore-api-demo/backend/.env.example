# ---------------------------------------------------------------------------
# App targets
# ---------------------------------------------------------------------------
# The app works with MANY apps across MANY accounts. Configure them in
# backend/apps.json (see apps.json.example) — an array where each entry is one
# app + its account credentials.
#
# The vars below are the FALLBACK single target used only when apps.json is
# missing/empty. (You no longer need APP_STORE_VERSION_ID / LOCALIZATION_ID —
# the editable version and primary locale are discovered automatically.)
ISSUER_ID=
KEY_ID=
PRIVATE_KEY_PATH=./AuthKey_ABC123DEFG.p8
APP_ID=

# Local server port (optional, defaults to 3000).
PORT=3000

# OpenAI API key (used to translate metadata into each locale's language).
# Get one at https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# Optional: which OpenAI chat model to use for translation (default gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# Default screenshots folder (a target in apps.json can override via
# "screenshotsDir"). Put your images there; the backend detects each one's
# display type from its pixel size.
SCREENSHOTS_DIR=./screenshots

# Optional: force one display type for ALL images in the folder (skip size
# detection), e.g. APP_IPHONE_67, APP_IPHONE_69, APP_IPAD_PRO_3GEN_129.
SCREENSHOT_DISPLAY_TYPE=

# Default outbound proxy (a target in apps.json can override via "proxyUrl"), so
# requests leave from the proxy's IP. Supports http/https/socks. Examples:
#   PROXY_URL=http://user:pass@host:8080
#   PROXY_URL=socks5://host:1080
PROXY_URL=

# Telegram status digest (optional). Every STATUS_INTERVAL_MINUTES the backend
# reports EACH target's latest version state (Waiting for Review, In Review,
# Pending Developer Release, ...) to your bot in one message.
#   TELEGRAM_BOT_TOKEN = the BOT TOKEN from @BotFather (e.g. 123456789:AA...),
#                        NOT a @username. (Aliases also read: TELEGREM_BOT_TOKEN,
#                        MAX_T_TELEGREM_BOT.)
#   TELEGRAM_CHAT_ID    = the chat id to send to. Message your bot, then open
#                        https://api.telegram.org/bot<TOKEN>/getUpdates and copy
#                        chat.id (or ask @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# How often (minutes) to report the version status. Default 5.
STATUS_INTERVAL_MINUTES=5
# How often (hours) to poll ESTABLISHED apps (Ready For Sale + version >= 1.2 /
# 1.0.2) — fewer requests on stable apps. Default 24.
STABLE_INTERVAL_HOURS=24
